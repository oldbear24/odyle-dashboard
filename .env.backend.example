DISCORD_CLIENT_ID=your-discord-application-id
DISCORD_CLIENT_SECRET=your-discord-client-secret

# Optional: keep the nightly backups off the host, in a private S3-compatible bucket
# (docs/deployment.md#backups-and-restore). Set all five, or none.
# ODYLE_BACKUP_S3_BUCKET=odyle-backups
# ODYLE_BACKUP_S3_REGION=eu-central-1
# ODYLE_BACKUP_S3_ENDPOINT=https://s3.eu-central-1.amazonaws.com
# ODYLE_BACKUP_S3_ACCESS_KEY=your-access-key
# ODYLE_BACKUP_S3_SECRET=your-secret-key
# ODYLE_BACKUP_S3_FORCE_PATH_STYLE=false

# Optional: the one header your own reverse proxy writes the client's address into, so
# rate limits count each player (docs/deployment.md#reverse-proxy). Only for a proxy that
# replaces the header; a list of headers is refused. Rightmost (default) or leftmost
# address of a list.
# ODYLE_TRUSTED_PROXY_HEADERS=X-Real-IP
# ODYLE_TRUSTED_PROXY_IP=rightmost
